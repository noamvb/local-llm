<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Downloading the model file. No other network use exists in this app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Explicit owner-started model transfer only; inference remains a bound service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Download and inference progress notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Only this app's own signature, or one of the certificates listed in
      @array/localllm_known_signers, may bind the inference service. Binder methods then
      enforce the narrower exact package-plus-signing-lineage allowlist in the same
      resource file; request clientId is never authorization.

      knownSigner is required rather than a plain signature check because the three apps
      are signed by three DIFFERENT keys: Poop Schedule with its own release keystore,
      Cannsheet Mobile with a debug certificate, and this app with its own. A plain
      "signature" permission would be granted to none of them. knownSigner needs API 31,
      which is this app's minimum.

      Known ordering hazard: the permission is only granted if the app that DEFINES it is
      installed first. Install or update LocalLLM before the clients.
    -->
    <permission
        android:name="com.noamv.localllm.permission.INFERENCE"
        android:label="@string/permission_inference_label"
        android:description="@string/permission_inference_description"
        android:protectionLevel="signature|knownSigner"
        android:knownCerts="@array/localllm_known_signers" />

    <uses-permission android:name="com.noamv.localllm.permission.INFERENCE" />

    <!-- Exact visibility for the two packages whose Binder UIDs may be authorized. -->
    <queries>
        <package android:name="com.noamv.poopschedule" />
        <package android:name="com.noamv.cannsheet.mobile" />
    </queries>

    <application
        android:name=".LocalLlmApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalLLM"
        tools:targetApi="36">

        <!--
          Required by the LiteRT-LM GPU backend. Marked not-required so the app still
          installs and falls back to CPU on devices lacking an OpenCL driver.
        -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The cross-app inference service.

          It is NOT a foreground service. Promoting it while serving a bound request would
          be denied whenever the calling client is itself in the background, because the
          system evaluates the binding client's eligibility, and the resulting
          ForegroundServiceStartNotAllowedException lands in this process where the client
          cannot catch it. The BIND_AUTO_CREATE binding already keeps this process alive
          for the duration. A client needing a stronger guarantee runs its own foreground
          service around the request and the state propagates over the binding.
        -->
        <service
            android:name=".service.InferenceService"
            android:exported="true"
            android:permission="com.noamv.localllm.permission.INFERENCE">
            <intent-filter>
                <action android:name="com.noamv.localllm.action.BIND_INFERENCE" />
            </intent-filter>
        </service>

        <!--
          Private, user-started model transfer owner. It is non-sticky, holds no Binder
          API, and stops immediately after verified atomic promotion. Process death leaves
          a resumable partial and never restarts network work by itself.
        -->
        <service
            android:name=".service.ModelTransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
